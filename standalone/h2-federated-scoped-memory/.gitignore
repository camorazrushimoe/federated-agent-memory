# H2 local run state — never commit. The root .gitignore un-ignores this
# directory on purpose (tracked docs: data/README.md, data/gold_useful.seed.jsonl),
# so run-state files must be excluded here. fixtures/ is NEVER ignored.
data/dialogues.jsonl
data/sessions.jsonl
data/ratings.jsonl
data/candidates.jsonl
data/ranked.jsonl
data/packet.json
data/serves.jsonl
data/outcomes.jsonl
data/query_meta.json
data/update_state.json
data/raw/
data/raw_gold_useful/
data/abcd_*.jsonl
data/preview_10.jsonl
data/replay/
# Phase C run inputs (raw transcripts — PII domain, never committed)
data/dialogues_pool.jsonl
data/dialogues_slice.jsonl
# Phase C run dirs: derived metrics files (manifest/audit/checks/metrics/
# cost/per_query/report.md) are committed; transcripts and run state (PII
# domain) are not.
runs/*/data/
runs/*/packets/
